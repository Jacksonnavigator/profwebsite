{
  "name": "kivevele-website",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr scripts/prerender-entry.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src scripts tests playwright.config.ts",
    "test": "playwright test",
    "test:report": "playwright show-report",
    "validate": "npm run typecheck && npm run lint && npm run build && npm test",
    "format": "prettier --write src scripts tests *.ts *.js *.json *.md .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests *.ts *.js *.json *.md .github/workflows/*.yml"
  },
  "dependencies": {
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.4.20",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
